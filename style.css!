:root {
  --bg: #0D0D0D;
  --accent: #E11D48;
  --accent-soft: rgba(225, 29, 72, 0.16);
  --white: #FFFFFF;
  --white-dim: rgba(255, 255, 255, 0.68);
  --white-faint: rgba(255, 255, 255, 0.38);
  --glass: rgba(255, 255, 255, 0.05);
  --glass-border: rgba(255, 255, 255, 0.10);
  --radius: 24px;
  --radius-sm: 14px;
  --ease: 250ms cubic-bezier(0.4, 0, 0.2, 1);
  --success: #22C55E;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
  background: var(--bg);
  color: var(--white);
  font-family: -apple-system, "Segoe UI", Roboto, "Inter", sans-serif;
  min-height: 100vh;
}

.bg-glow {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(600px circle at 15% 10%, var(--accent-soft), transparent 60%),
    radial-gradient(500px circle at 85% 90%, var(--accent-soft), transparent 60%);
}

/* ---------- Topbar ---------- */
.topbar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 28px;
  background: rgba(13, 13, 13, 0.72);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--glass-border);
}

.brand { display: flex; align-items: center; gap: 10px; }
.brand-logo { width: 28px; height: 28px; }
.brand-name { font-weight: 700; letter-spacing: -0.01em; }

.topnav { display: flex; gap: 10px; }

.navbtn {
  background: var(--glass);
  border: 1px solid var(--glass-border);
  color: var(--white-dim);
  padding: 10px 16px;
  border-radius: 999px;
  font-size: 0.85rem;
  cursor: pointer;
  transition: all var(--ease);
}
.navbtn:hover { color: var(--white); border-color: var(--accent); }
.navbtn-accent {
  background: var(--accent);
  color: var(--white);
  border-color: var(--accent);
}
.navbtn-accent:hover { filter: brightness(1.1); }

/* ---------- Layout ---------- */
.stage {
  position: relative;
  z-index: 1;
  max-width: 720px;
  margin: 0 auto;
  padding: 48px 20px 96px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.panel {
  background: var(--glass);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius);
  backdrop-filter: blur(20px);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
  padding: 32px;
  animation: rise var(--ease) both;
}

@keyframes rise {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

.hidden { display: none !important; }

/* ---------- Hero ---------- */
.panel-hero { text-align: center; }
.panel-hero h1 {
  font-size: 2rem;
  margin: 0 0 6px;
  background: linear-gradient(135deg, var(--white), var(--white-dim));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.subtitle { color: var(--white-dim); margin: 0 0 28px; }

.dropzone {
  border: 2px dashed var(--glass-border);
  border-radius: var(--radius);
  padding: 48px 24px;
  transition: all var(--ease);
  cursor: pointer;
}
.dropzone:hover, .dropzone.dragover {
  border-color: var(--accent);
  background: var(--accent-soft);
}
.dropzone-icon { font-size: 2.4rem; margin-bottom: 8px; }
.dropzone-text { font-weight: 600; margin: 0; }
.dropzone-sub { color: var(--white-faint); margin: 8px 0; font-size: 0.85rem; }

.verify-result {
  margin-top: 20px;
  padding: 14px 18px;
  border-radius: var(--radius-sm);
  font-size: 0.88rem;
  text-align: left;
}
.verify-result.ok { background: rgba(34, 197, 94, 0.12); border: 1px solid rgba(34, 197, 94, 0.35); }
.verify-result.error { background: rgba(225, 29, 72, 0.12); border: 1px solid rgba(225, 29, 72, 0.4); }
.verify-result ul { margin: 6px 0 0; padding-left: 18px; }

/* ---------- Buttons ---------- */
.btn {
  border: none;
  border-radius: 999px;
  padding: 12px 22px;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--ease);
}
.btn-primary { background: var(--white); color: var(--bg); }
.btn-primary:hover { transform: translateY(-1px); filter: brightness(0.95); }
.btn-accent { background: var(--accent); color: var(--white); }
.btn-accent:hover { transform: translateY(-1px); filter: brightness(1.1); }
.btn-ghost { background: transparent; color: var(--white-dim); border: 1px solid var(--glass-border); }
.btn-large { width: 100%; padding: 16px; font-size: 1rem; margin-top: 8px; }
.btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

/* ---------- Cards ---------- */
.panel-card h2 { margin-top: 0; }
.card-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
  margin: 18px 0;
}
.card-item {
  background: rgba(255, 255, 255, 0.03);
  border-radius: var(--radius-sm);
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.card-item .label { font-size: 0.72rem; color: var(--white-faint); text-transform: uppercase; letter-spacing: 0.04em; }
.card-item .value { font-weight: 600; word-break: break-all; }

.panel-success { border-color: rgba(34, 197, 94, 0.4); }
.success-icon {
  width: 52px; height: 52px; border-radius: 50%;
  background: rgba(34, 197, 94, 0.15); color: var(--success);
  display: flex; align-items: center; justify-content: center;
  font-size: 1.4rem; margin-bottom: 12px;
}
.panel-error { border-color: rgba(225, 29, 72, 0.4); }
.error-icon {
  width: 52px; height: 52px; border-radius: 50%;
  background: var(--accent-soft); color: var(--accent);
  display: flex; align-items: center; justify-content: center;
  font-size: 1.4rem; margin-bottom: 12px;
}
.error-message { color: var(--white-dim); }

/* ---------- Steps / progress ---------- */
.steps-list {
  list-style: none;
  padding: 0;
  margin: 18px 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}
.steps-list li {
  font-size: 0.78rem;
  color: var(--white-faint);
  background: rgba(255, 255, 255, 0.03);
  border-radius: var(--radius-sm);
  padding: 10px;
  text-align: center;
  transition: all var(--ease);
  border: 1px solid transparent;
}
.steps-list li.active {
  color: var(--white);
  border-color: var(--accent);
  background: var(--accent-soft);
}
.steps-list li.done {
  color: var(--success);
  background: rgba(34, 197, 94, 0.08);
}

.progress-bar-outer {
  width: 100%;
  height: 10px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.06);
  overflow: hidden;
}
.progress-bar-inner {
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, var(--accent), #ff5b7f);
  transition: width var(--ease);
}
.progress-meta {
  display: flex;
  justify-content: space-between;
  font-size: 0.78rem;
  color: var(--white-faint);
  margin-top: 8px;
}

.logs { margin-top: 16px; }
.logs summary { cursor: pointer; color: var(--white-dim); font-size: 0.85rem; }
.logs pre {
  margin-top: 10px;
  max-height: 220px;
  overflow: auto;
  background: rgba(0, 0, 0, 0.4);
  border-radius: var(--radius-sm);
  padding: 12px;
  font-size: 0.75rem;
  color: var(--white-dim);
  white-space: pre-wrap;
}

/* ---------- Side panels ---------- */
.side-panel {
  position: fixed;
  top: 0; right: 0;
  height: 100%;
  width: 340px;
  max-width: 90vw;
  background: rgba(13, 13, 13, 0.92);
  backdrop-filter: blur(20px);
  border-left: 1px solid var(--glass-border);
  z-index: 20;
  transform: translateX(0);
  transition: transform var(--ease);
  overflow-y: auto;
}
.side-panel.hidden { transform: translateX(100%); display: block; }

.side-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 24px;
  border-bottom: 1px solid var(--glass-border);
}
.closeBtn {
  background: none; border: none; color: var(--white-dim);
  font-size: 1.1rem; cursor: pointer;
}
.side-panel-body { padding: 20px 24px; display: flex; flex-direction: column; gap: 14px; }

.field { display: flex; flex-direction: column; gap: 6px; font-size: 0.82rem; color: var(--white-dim); }
.field input, .field select {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  padding: 10px 12px;
  color: var(--white);
  font-size: 0.88rem;
}
.field input:focus, .field select:focus { outline: none; border-color: var(--accent); }
.divider { border: none; border-top: 1px solid var(--glass-border); margin: 8px 0; }
.hint { font-size: 0.78rem; color: var(--white-faint); margin: 0; }

.history-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
.history-list li {
  background: rgba(255, 255, 255, 0.03);
  border-radius: var(--radius-sm);
  padding: 12px 14px;
  font-size: 0.82rem;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.history-empty { color: var(--white-faint); }
.history-status { font-size: 0.72rem; padding: 2px 8px; border-radius: 999px; align-self: flex-start; }
.history-status.success { background: rgba(34, 197, 94, 0.15); color: var(--success); }
.history-status.error { background: var(--accent-soft); color: var(--accent); }

/* ---------- Modal ---------- */
.modal {
  position: fixed; inset: 0; z-index: 30;
  background: rgba(0, 0, 0, 0.6);
  display: flex; align-items: center; justify-content: center;
  backdrop-filter: blur(4px);
}
.modal.hidden { display: none; }
.modal-card {
  background: #141414;
  border: 1px solid var(--glass-border);
  border-radius: var(--radius);
  padding: 32px;
  max-width: 380px;
  text-align: center;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
}
.auth-code {
  font-size: 1.6rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  background: var(--accent-soft);
  border-radius: var(--radius-sm);
  padding: 14px;
  margin: 16px 0;
  color: var(--accent);
}

/* ---------- Toasts ---------- */
.toast-container {
  position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
  z-index: 40; display: flex; flex-direction: column; gap: 8px;
}
.toast {
  background: #141414;
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  padding: 12px 18px;
  font-size: 0.85rem;
  animation: rise var(--ease) both;
}
.toast.error { border-color: var(--accent); color: var(--accent); }
.toast.success { border-color: var(--success); color: var(--success); }

/* ---------- Responsive ---------- */
@media (max-width: 560px) {
  .stage { padding: 28px 14px 80px; }
  .panel { padding: 22px; }
  .card-grid { grid-template-columns: 1fr; }
  .steps-list { grid-template-columns: repeat(2, 1fr); }
  .topbar { padding: 14px 16px; }
  .navbtn { padding: 8px 12px; font-size: 0.78rem; }
}
